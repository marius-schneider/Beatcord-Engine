{
  "name": "@beatcord/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
    "scripts": {
        "benchmark:golden-mixes": "bun scripts/golden-mix-benchmark.ts",
        "benchmark:human": "bun scripts/human-benchmark.ts",
        "benchmark:performance": "bun scripts/performance-audit.ts",
        "soak:director": "bun scripts/director-soak.ts",
        "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "biome check src && tsc --noEmit && bun test src"
  },
  "dependencies": {
    "aubiojs": "^0.2.1",
    "essentia.js": "^0.1.3",
    "music-tempo": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
