From 742462bae7ed00da1198f6ffb28067ef481158f2 Mon Sep 17 00:00:00 2001
From: Marius Schneider <marius.schnd@icloud.com>
Date: Thu, 13 Aug 2026 14:47:55 +0200
Subject: [PATCH 1/5] Relax over-strict response models so one odd field can't
 kill a response

api.tidal.com/v1/artists/{id} no longer returns `type` at all (verified on 6
artists), so Artist.type: Literal["MAIN","FEATURED"] made every get_artist call
raise ValidationError. Supersedes PR #426, which only added a comment.

Also loosens the enums TIDAL has been growing values for (Album.type,
Role.category, artistTypes, mediaMetadata.tags) from Literal to str, and makes
the nested Artist.type optional. For a client, an unknown enum value should
degrade to a string, not discard the whole payload.

Fixes #424, #383.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 tiddl/core/api/models/resources.py | 26 +++++++++-----------------
 1 file changed, 9 insertions(+), 17 deletions(-)

diff --git a/tiddl/core/api/models/resources.py b/tiddl/core/api/models/resources.py
index a89f19f..0633ad2 100644
--- a/tiddl/core/api/models/resources.py
+++ b/tiddl/core/api/models/resources.py
@@ -16,7 +16,7 @@ class Track(BaseModel):
     class Artist(BaseModel):
         id: int
         name: str
-        type: str
+        type: Optional[str] = None
         picture: Optional[str] = None
 
     class Album(BaseModel):
@@ -27,7 +27,7 @@ class Track(BaseModel):
         videoCover: Optional[str] = None
 
     class MediaMetadata(BaseModel):
-        tags: list[MediaMetadataTags]
+        tags: List[str]
 
     id: int
     title: str
@@ -65,7 +65,7 @@ class Video(BaseModel):
     class Artist(BaseModel):
         id: int
         name: str
-        type: str
+        type: Optional[str] = None
         picture: Optional[str] = None
 
     class Album(BaseModel):
@@ -106,11 +106,11 @@ class Album(BaseModel):
     class Artist(BaseModel):
         id: int
         name: str
-        type: Literal["MAIN", "FEATURED"]
+        type: Optional[str] = None
         picture: Optional[str] = None
 
     class MediaMetadata(BaseModel):
-        tags: List[MediaMetadataTags]
+        tags: List[str]
 
     id: int
     title: str
@@ -127,7 +127,7 @@ class Album(BaseModel):
     numberOfVolumes: int
     releaseDate: datetime | None = None
     copyright: Optional[str] = None
-    type: Literal["ALBUM", "SINGLE", "EP"]
+    type: str
     version: Optional[str] = None
     url: str
     cover: Optional[str] = None
@@ -172,15 +172,7 @@ class Artist(BaseModel):
 
     class Role(BaseModel):
         categoryId: int
-        category: Literal[
-            "Artist",
-            "Songwriter",
-            "Performer",
-            "Producer",
-            "Engineer",
-            "Production team",
-            "Misc",
-        ]
+        category: str
 
     class Mix(BaseModel):
         ARTIST_MIX: str
@@ -188,8 +180,8 @@ class Artist(BaseModel):
 
     id: int
     name: str
-    type: Literal["MAIN", "FEATURED"]
-    artistTypes: Optional[List[Literal["ARTIST", "CONTRIBUTOR"]]] = None
+    type: Optional[str] = None
+    artistTypes: Optional[List[str]] = None
     url: Optional[str] = None
     picture: Optional[str] = None
     selectedAlbumCoverFallback: Optional[str] = None
