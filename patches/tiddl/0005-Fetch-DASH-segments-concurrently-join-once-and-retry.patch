-        for url in urls:
-            req = s.get(url)
-            stream_data += req.content
 
-    return stream_data
+def download(urls: list[str]) -> bytes:
+    """Fetch every segment and return them concatenated in order.
+
+    A DASH manifest can be dozens of segments (a 4-minute hi-res track is ~73), so
+    three things matter here that the naive loop got wrong:
+
+    - Segments are fetched concurrently. Ordering still comes from the input list
+      because `ThreadPoolExecutor.map` yields results in submission order.
+    - The pieces are joined once instead of `data += chunk` per segment. Repeated
+      concatenation re-copies the whole accumulated buffer each time, which is
+      quadratic — for ~96 MB across 73 segments that is gigabytes of memcpy — and
+      it transiently holds two full copies of the track.
+    - A segment is retried before the whole download is written off. One blip
+      losing an otherwise complete 96 MB transfer is the worst failure mode here.
+    """
+
+    if not urls:
+        return b""
+
+    local = threading.local()
+    sessions: list[Session] = []
+    sessions_lock = threading.Lock()
+
+    def session() -> Session:
+        # One Session per worker thread: sharing a single one across threads is not
+        # guaranteed safe, and a fresh one per request would drop connection reuse.
+        s = getattr(local, "session", None)
+        if s is None:
+            s = local.session = Session()
+            with sessions_lock:
+                sessions.append(s)
+        return s
+
+    def fetch(url: str) -> bytes:
+        last: Exception | None = None
+        for attempt in range(1, SEGMENT_RETRIES + 1):
+            try:
+                res = session().get(url)
+                res.raise_for_status()
+                return res.content
+            except Exception as e:  # connection reset, 5xx, read timeout, …
+                last = e
+                if attempt < SEGMENT_RETRIES:
+                    sleep(0.25 * 2 ** (attempt - 1))
+        raise RuntimeError(f"segment failed after {SEGMENT_RETRIES} attempts: {last}")
+
+    try:
+        if len(urls) == 1:
+            return fetch(urls[0])
+
+        with ThreadPoolExecutor(
+            max_workers=min(SEGMENT_WORKERS, len(urls)), thread_name_prefix="segment"
+        ) as pool:
+            return b"".join(pool.map(fetch, urls))
+    finally:
+        for s in sessions:
+            s.close()
 
 
 def get_track_stream_data(track_stream: TrackStream) -> tuple[bytes, str]:
