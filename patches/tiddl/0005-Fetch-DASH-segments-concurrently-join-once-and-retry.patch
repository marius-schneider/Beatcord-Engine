--- /dev/null
+++ b/tests/core/utils/test_utils_download.py
@@ -0,0 +1,115 @@
+import threading
+
+import pytest
+
+from tiddl.core.utils import download as download_module
+from tiddl.core.utils.download import SEGMENT_RETRIES, download
+
+
+class FakeResponse:
+    def __init__(self, content: bytes):
+        self.content = content
+
+    def raise_for_status(self) -> None:
+        pass
+
+
+class FakeSession:
+    """Stands in for requests.Session. `behaviour` maps a url to either bytes or a
+    callable invoked per attempt, so a test can fail a url a set number of times."""
+
+    created: list["FakeSession"] = []
+
+    def __init__(self, behaviour: dict):
+        self._behaviour = behaviour
+        self.closed = False
+        self.threads: set[str] = set()
+        FakeSession.created.append(self)
+
+    def get(self, url: str):
+        self.threads.add(threading.current_thread().name)
+        outcome = self._behaviour[url]
+        if callable(outcome):
+            outcome = outcome()
+        return FakeResponse(outcome)
+
+    def close(self) -> None:
+        self.closed = True
+
+
+@pytest.fixture
+def fake_sessions(monkeypatch):
+    """Patch the Session the module actually uses and hand back the registry."""
+
+    def install(behaviour: dict):
+        FakeSession.created.clear()
+        monkeypatch.setattr(download_module, "Session", lambda: FakeSession(behaviour))
+        return FakeSession.created
+
+    return install
+
+
+def test_returns_empty_without_urls(fake_sessions):
+    fake_sessions({})
+    assert download([]) == b""
+
+
+def test_single_url_skips_the_pool(fake_sessions):
+    sessions = fake_sessions({"a": b"only"})
+    assert download(["a"]) == b"only"
+    assert len(sessions) == 1
+
+
+def test_segments_are_concatenated_in_request_order(fake_sessions):
+    # Deliberately more urls than workers, so results genuinely come back out of
+    # order and ordering has to come from the input list rather than completion.
+    urls = [f"u{i}" for i in range(20)]
+    fake_sessions({u: f"<{u}>".encode() for u in urls})
+
+    assert download(urls) == b"".join(f"<{u}>".encode() for u in urls)
+
+
+def test_a_flaky_segment_is_retried_rather_than_losing_the_download(fake_sessions):
+    attempts = {"n": 0}
+
+    def flaky():
+        attempts["n"] += 1
+        if attempts["n"] < SEGMENT_RETRIES:
+            raise ConnectionError("reset by peer")
+        return b"late"
+
+    fake_sessions({"good": b"fine", "flaky": flaky})
+
+    assert download(["good", "flaky"]) == b"finelate"
+    assert attempts["n"] == SEGMENT_RETRIES
+
+
+def test_a_permanently_failing_segment_raises(fake_sessions):
+    def always_fails():
+        raise ConnectionError("gone")
+
+    fake_sessions({"good": b"fine", "dead": always_fails})
+
+    with pytest.raises(RuntimeError, match="segment failed after"):
+        download(["good", "dead"])
+
+
+def test_every_session_is_closed(fake_sessions):
+    urls = [f"u{i}" for i in range(12)]
+    sessions = fake_sessions({u: b"x" for u in urls})
+
+    download(urls)
+
+    assert sessions, "expected at least one session"
+    assert all(s.closed for s in sessions)
+
+
+def test_work_is_spread_across_threads(fake_sessions):
+    urls = [f"u{i}" for i in range(40)]
+    sessions = fake_sessions({u: b"x" for u in urls})
+
+    download(urls)
+
+    # One session per worker thread, and no session is shared between threads.
+    assert len(sessions) > 1
+    assert all(len(s.threads) == 1 for s in sessions)
